# Demo mode works without credentials. All secrets are server-only.
API_ORIGIN=http://127.0.0.1:8000
API_PORT=8000
PORT=3000
# Optional absolute directory for local strategy/theme overrides and demo SQLite.
# API_DATA_DIR=/workspace/stcock/.runtime

# auto attempts documented read-only ingestion only with supplied credentials.
# It stays demo until real observations pass schema/venue/freshness checks.
# Set demo to disable all automatic and manual authentication/network reads.
TOSS_DATA_MODE=auto
# Toss requires the actual API request's fixed public egress IP in its allowlist.
# WTS > Settings > Open API > Allowed IP management. Never paste values in chat.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
# Legacy manifest adapter options; the current ingestion uses client credentials.
# TOSS_ACCESS_TOKEN=
# TOSS_API_MANIFEST=/absolute/path/to/verified-manifest.json

# Optional future infrastructure; the demo currently persists to SQLite.
# DATABASE_URL=postgresql://flowtrade:local-development-only@localhost:5432/flowtrade
# REDIS_URL=redis://localhost:6379/0
ENABLE_LIVE_TRADING=false
