{
  "name": "flowtrade-radar",
  "version": "1.2.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @flowtrade/web",
    "build": "npm run build --workspace @flowtrade/web",
    "start": "npm run start --workspace @flowtrade/web",
    "start:production": "node scripts/start-prod.mjs",
    "typecheck": "npm run typecheck --workspace @flowtrade/web",
    "test:api": "PYTHONPATH=apps/api .venv/bin/python -m pytest apps/api/tests -q",
    "test:e2e": "node scripts/smoke.mjs",
    "test:e2e:discovery": "node scripts/discovery-smoke.mjs"
  }
}
